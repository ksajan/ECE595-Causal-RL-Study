{
  "artifact_schema": "ctrl-cartpole-oracle-confirmatory-v1",
  "experiment_name": "cartpole_oracle_confirmatory",
  "seeds": [
    1000, 1001, 1002, 1003, 1004, 1005, 1006, 1007, 1008, 1009,
    1010, 1011, 1012, 1013, 1014, 1015, 1016, 1017, 1018, 1019,
    1020, 1021, 1022, 1023, 1024, 1025, 1026, 1027, 1028, 1029
  ],
  "config": {
    "dataset_trials": 250,
    "trial_horizon": 20,
    "stop_on_termination": true,
    "state_noise_std": 0.05,
    "action_noise_std": 0.05,
    "noise_semantics": "process",
    "train_steps": 5000,
    "batch_size": 256,
    "gamma": 0.99,
    "learning_rate": 0.0001,
    "target_tau": 0.005,
    "target_update_interval": 0,
    "cql_alpha": 0.05,
    "cf_batch_fraction": 0.5,
    "q_width": 256,
    "q_depth": 2,
    "q_batch_norm": false,
    "eval_episodes": 100,
    "eval_horizon": 500,
    "eval_seed_base": 600000
  },
  "arms": ["random", "real", "fresh_noise", "oracle_cf"],
  "evaluation": {
    "metrics": ["clean", "noisy"],
    "episodes_are_not_training_replicates": true
  },
  "statistics": {
    "primary": "oracle_cf_minus_fresh_noise_clean",
    "contrasts": [
      "oracle_cf_minus_fresh_noise_clean",
      "oracle_cf_minus_fresh_noise_noisy",
      "oracle_cf_minus_real_clean",
      "fresh_noise_minus_real_clean"
    ],
    "practical_effect_thresholds": {
      "clean": 25.0,
      "noisy": 5.0
    },
    "bootstrap_samples": 20000,
    "randomization_samples": 100000,
    "alpha": 0.05
  }
}
